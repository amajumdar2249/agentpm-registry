    "\u5bfe\u8c61": "\u30e9\u30f3\u30c7\u30a3\u30f3\u30b0\u30da\u30fc\u30b8\u3001\u30db\u30fc\u30e0\u30da\u30fc\u30b8\u3001\u4fa1\u683c\u30da\u30fc\u30b8\u3001\u6a5f\u80fd\u30da\u30fc\u30b8\u3001\u30d6\u30ed\u30b0\u3002",
    "\u4f7f\u7528\u30bf\u30a4\u30df\u30f3\u30b0": "(1) \u30da\u30fc\u30b8\u306e\u76e3\u67fb\u30fb\u5206\u6790\u4f9d\u983c (2) \u30b3\u30f3\u30d0\u30fc\u30b8\u30e7\u30f3\u6539\u5584\u76f8\u8ac7",
    "\u30c8\u30ea\u30ac\u30fc\u4f8b": "\u300cLP\u3092\u5206\u6790\u3057\u3066\u300d\u300c\u30b3\u30f3\u30d0\u30fc\u30b8\u30e7\u30f3\u7387\u3092\u4e0a\u3052\u305f\u3044\u300d\u300c\u4fa1\u683c\u30da\u30fc\u30b8\u3092\u30ec\u30d3\u30e5\u30fc\u300d"
  }
}